{
  "name": "df-youtube-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "cross-env BROWSER=chrome ng build",
    "build:chrome": "cross-env BROWSER=chrome ng build --output-path=dist/chrome",
    "build:edge": "cross-env BROWSER=edge ng build --output-path=dist/edge",
    "build:firefox": "cross-env BROWSER=firefox ng build --output-path=dist/firefox",
    "build:opera": "cross-env BROWSER=opera ng build --output-path=dist/opera",
    "build:all": "npm run build:chrome && npm run build:edge && npm run build:firefox && npm run build:opera",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e:dashboard": "node e2e/dashboard/server.mjs --open",
    "e2e:build": "npm run build:chrome && npm run build:edge",
    "e2e:open:local-chrome": "node e2e/scripts/open-browser.mjs local-chrome",
    "e2e:open:local-edge": "node e2e/scripts/open-browser.mjs local-edge",
    "e2e:open:prod-chrome": "node e2e/scripts/open-browser.mjs prod-chrome",
    "e2e:open:prod-edge": "node e2e/scripts/open-browser.mjs prod-edge",
    "e2e:local": "npm run e2e:build && playwright test -c e2e --project=local-chrome --project=local-edge",
    "e2e:local:chrome": "npm run build:chrome && playwright test -c e2e --project=local-chrome",
    "e2e:local:edge": "npm run build:edge && playwright test -c e2e --project=local-edge",
    "e2e:prod": "playwright test -c e2e --project=prod-chrome --project=prod-edge",
    "e2e:prod:chrome": "playwright test -c e2e --project=prod-chrome",
    "e2e:prod:edge": "playwright test -c e2e --project=prod-edge",
    "e2e:daily": "powershell -NoProfile -ExecutionPolicy Bypass -File e2e/scripts/run-daily.ps1",
    "e2e:mocked": "npm run build:chrome && playwright test -c e2e --project=mocked",
    "e2e:report": "node e2e/scripts/show-report.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular-builders/custom-webpack": "^18.0.0",
    "@angular/animations": "^18.2.10",
    "@angular/cdk": "^18.2.12",
    "@angular/common": "^18.2.10",
    "@angular/compiler": "^18.2.10",
    "@angular/core": "^18.2.10",
    "@angular/forms": "^18.2.10",
    "@angular/platform-browser": "^18.2.10",
    "@angular/platform-browser-dynamic": "^18.2.10",
    "@angular/router": "^18.2.10",
    "@fontsource/roboto": "^5.2.5",
    "@nebular/eva-icons": "14.0.2",
    "@nebular/theme": "^14.0.2",
    "@types/chrome": "^0.0.280",
    "copy-webpack-plugin": "^6.3.1",
    "eva-icons": "^1.1.3",
    "npm": "^11.5.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "zone.js": "^0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.11",
    "@angular/cli": "^18.2.11",
    "@angular/compiler-cli": "^18.2.10",
    "@playwright/test": "^1.64.1",
    "@schematics/angular": "^18.2.11",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^25.6.0",
    "cross-env": "^10.1.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.4.5"
  }
}
